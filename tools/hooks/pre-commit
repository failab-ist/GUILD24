#!/bin/sh
# 커밋 전에 전체 테스트를 돌린다. 7초면 끝나고, 이게 없으면 "돌리는 걸 잊은" 커밋이 들어간다.
# 설치:  npm run hooks
# 우회 :  git commit --no-verify   (정말 필요할 때만)
echo "pre-commit: npm test"
if ! npm test >/tmp/guild24-precommit.log 2>&1; then
  echo ""
  echo "  테스트 실패 — 커밋을 멈춥니다."
  tail -25 /tmp/guild24-precommit.log
  echo ""
  echo "  전체 로그: /tmp/guild24-precommit.log"
  exit 1
fi
echo "pre-commit: 통과"
